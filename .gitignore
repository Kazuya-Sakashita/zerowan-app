# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# If you find yourself ignoring temporary files generated by your text editor
# or operating system, you probably want to add a global ignore instead:
#   git config --global core.excludesfile '~/.gitignore_global'

# =========================
# OS / Editor artifacts
# =========================
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Desktop.ini
.vscode/
.idea/
*.swp
*.swo

# =========================
# Bundler / Ruby / Rails
# =========================
# Ignore bundler config.
/.bundle
/vendor/bundle

# Rails logs / temp
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# pidfiles, but keep the directory
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Active Storage (development uploads)
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

# Assets & uploads
/public/assets
/public/uploads
/public/uploads/*

# Credentials
/config/master.key

# RSpec / coverage
.rspec_status
coverage/
spec/examples.txt

# Byebug history
.byebug_history

# =========================
# JavaScript / Node
# =========================
/node_modules
yarn-error.log
npm-debug.log*
pnpm-debug.log*

# =========================
# Env / Settings (local only)
# =========================
.env
.env.*
config/settings.local.yml
config/settings/*.local.yml
config/environments/*.local.yml

# =========================
# Rails (asset builds)
# =========================
/app/assets/builds/*
!/app/assets/builds/.keep
